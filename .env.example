# Node Environment & Server Port
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5434/mydb?schema=public"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production-12345"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production-67890"

# Token Expiration Settings
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"
